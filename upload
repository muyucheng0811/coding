#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "錯誤：這個資料夾還不是 Git repository。"
    echo "請先執行：git init -b main"
    exit 1
fi

if ! git remote get-url origin >/dev/null 2>&1; then
    echo "錯誤：尚未設定 GitHub remote。"
    echo "請先執行：git remote add origin <你的 GitHub repository URL>"
    exit 1
fi

git add .

if git diff --cached --quiet; then
    echo "沒有新的練習內容需要上傳。"
    exit 0
fi

practice_date="$(date '+%Y-%m-%d')"
git commit -m "C++ practice: ${practice_date}"
git push -u origin "$(git branch --show-current)"

echo "已完成：今天的練習內容已上傳到 GitHub。"
